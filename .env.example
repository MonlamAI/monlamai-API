# Copy to `.env` and fill in values. Never commit real secrets.
#
# Notes:
# - `dotenv` is loaded in several modules (see `main.py`, `v1/utils/translator.py`, etc.)
# - OCR credentials are loaded from a file path (see `v1/utils/google_ocr.py`), not an env var.

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
PORT=8000

# Set to "production" to use `/etc/secrets/ocr_credentials.json` for OCR credentials
ENV=development

# ------------------------------------------------------------------------------
# Database (used by Prisma schema and app runtime)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/dbname

# Optional: test DB (defaults to sqlite in-memory when unset)
TEST_DATABASE_URL=sqlite:///:memory:

# ------------------------------------------------------------------------------
# Auth (token required for most routes)
# ------------------------------------------------------------------------------
# `API_KEY` is the token expected in `Authorization: Bearer <token>`
API_KEY=replace_me_with_a_long_random_token

# Model authorization token used when calling upstream model services
MODEL_AUTH=replace_me_with_model_auth_token

# ------------------------------------------------------------------------------
# Model endpoints
# ------------------------------------------------------------------------------
# Translation model (OpenAI-compatible chat completions endpoint expected at:
#   ${MT_MODEL_URL}/v1/chat/completions)
MT_MODEL_URL=https://example.com
MT_MODEL_NAME=replace_me_with_model_name

# LLM model endpoint used for translation_generate_stream and /translation
LLM_MODEL_URL=https://example.com

# Speech-to-text (some routes/utils reference these)
STT_MODEL_URL=https://example.com
STT_MODEL_URL_ENGLISH=https://example.com
STT_MODEL_URL_TIBETAN=https://example.com

# Text-to-speech
TTS_MODEL_URL=https://example.com

# ------------------------------------------------------------------------------
# Dedicated v2 backends (gateway will proxy)
# ------------------------------------------------------------------------------
# Example: http://localhost:8000 (or your internal service URL)
TTS_BACKEND_URL=http://localhost:8000
STT_BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Analytics / third-party services
# ------------------------------------------------------------------------------
MIXPANEL_TOKEN=replace_me
GEOAPIFY_API_KEY=replace_me

# ------------------------------------------------------------------------------
# AWS S3 (required for /api/v1/upload endpoints)
# ------------------------------------------------------------------------------
AWS_ACCESS_ID=replace_me
AWS_SECRET_KEY=replace_me
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=replace_me

